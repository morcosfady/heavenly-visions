{
  "rules": {
    ".read": false,
    ".write": false,
    "hostkeys": {
      "$pin": {
        ".write": "$pin.matches(/^[0-9]{6}$/) && ((!data.exists() || !root.child('live').child($pin).child('meta').exists()) && newData.exists() || !newData.exists() && !root.child('live').child($pin).child('meta').exists())",
        ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
      }
    },
    "hs": {
      "$pin": {
        ".write": "$pin.matches(/^[0-9]{6}$/) && (!newData.exists() || newData.isString() && newData.val().length <= 64)"
      }
    },
    "pk": {
      "$pin": {
        ".write": "$pin.matches(/^[0-9]{6}$/) && !root.child('live').child($pin).child('meta').exists() && !newData.exists()",
        "$uid": {
          ".write": "$pin.matches(/^[0-9]{6}$/) && ((!data.exists() || newData.val() === data.val()) && newData.exists() && root.child('live').child($pin).child('meta').exists() || !newData.exists() && !root.child('live').child($pin).child('meta').exists())",
          ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
        }
      }
    },
    "ps": {
      "$pin": {
        ".write": "$pin.matches(/^[0-9]{6}$/) && !root.child('live').child($pin).child('meta').exists() && !newData.exists()",
        "$uid": {
          ".write": "$pin.matches(/^[0-9]{6}$/) && (!newData.exists() || newData.isString() && newData.val().length <= 64)"
        }
      }
    },
    "live": {
      "$pin": {
        ".read": "$pin.matches(/^[0-9]{6}$/)",
        "meta": {
          ".write": "$pin.matches(/^[0-9]{6}$/) && (root.child('hostkeys').child($pin).exists() && newData.parent().parent().parent().child('hs').child($pin).val() === root.child('hostkeys').child($pin).val() && root.child('hs').child($pin).val() !== root.child('hostkeys').child($pin).val() || !root.child('live').child($pin).child('meta').exists() && newData.parent().parent().parent().child('hostkeys').child($pin).exists())",
          ".validate": "newData.hasChildren(['title','n','state'])",
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
          },
          "state": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "$o": {
            ".validate": "newData.isString() && newData.val().length <= 60 || newData.isNumber()"
          }
        },
        "cur": {
          ".write": "$pin.matches(/^[0-9]{6}$/) && root.child('hostkeys').child($pin).exists() && newData.parent().parent().parent().child('hs').child($pin).val() === root.child('hostkeys').child($pin).val() && root.child('hs').child($pin).val() !== root.child('hostkeys').child($pin).val()",
          ".validate": "newData.hasChildren(['k','text','ch','dur','t0'])",
          "k": {
            ".validate": "newData.isNumber()"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "ch": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            }
          },
          "dur": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 120"
          },
          "t0": {
            ".validate": "newData.isNumber()"
          },
          "open": {
            ".validate": "newData.isBoolean()"
          },
          "$o": {
            ".validate": "newData.isString() && newData.val().length <= 60 || newData.isNumber()"
          }
        },
        "rev": {
          ".write": "$pin.matches(/^[0-9]{6}$/) && root.child('hostkeys').child($pin).exists() && newData.parent().parent().parent().child('hs').child($pin).val() === root.child('hostkeys').child($pin).val() && root.child('hs').child($pin).val() !== root.child('hostkeys').child($pin).val()",
          "$any": {
            ".validate": true
          }
        },
        "sc": {
          ".write": "$pin.matches(/^[0-9]{6}$/) && root.child('hostkeys').child($pin).exists() && newData.parent().parent().parent().child('hs').child($pin).val() === root.child('hostkeys').child($pin).val() && root.child('hs').child($pin).val() !== root.child('hostkeys').child($pin).val()",
          "$uid": {
            ".validate": "newData.isNumber()"
          }
        },
        "fin": {
          ".write": "$pin.matches(/^[0-9]{6}$/) && root.child('hostkeys').child($pin).exists() && newData.parent().parent().parent().child('hs').child($pin).val() === root.child('hostkeys').child($pin).val() && root.child('hs').child($pin).val() !== root.child('hostkeys').child($pin).val()",
          "$uid": {
            ".write": "$pin.matches(/^[0-9]{6}$/) && newData.val() === true && (root.child('pk').child($pin).child($uid).exists() && newData.parent().parent().parent().parent().child('ps').child($pin).child($uid).val() === root.child('pk').child($pin).child($uid).val() && root.child('ps').child($pin).child($uid).val() !== root.child('pk').child($pin).child($uid).val() || !root.child('pk').child($pin).child($uid).exists() && newData.parent().parent().parent().parent().child('pk').child($pin).child($uid).exists())",
            ".validate": true
          }
        },
        "players": {
          ".write": "$pin.matches(/^[0-9]{6}$/) && !newData.exists() && root.child('hostkeys').child($pin).exists() && newData.parent().parent().parent().child('hs').child($pin).val() === root.child('hostkeys').child($pin).val() && root.child('hs').child($pin).val() !== root.child('hostkeys').child($pin).val()",
          "$uid": {
            ".write": "$pin.matches(/^[0-9]{6}$/) && (!data.exists() && newData.exists() && (root.child('pk').child($pin).child($uid).exists() && newData.parent().parent().parent().parent().child('ps').child($pin).child($uid).val() === root.child('pk').child($pin).child($uid).val() && root.child('ps').child($pin).child($uid).val() !== root.child('pk').child($pin).child($uid).val() || !root.child('pk').child($pin).child($uid).exists() && newData.parent().parent().parent().parent().child('pk').child($pin).child($uid).exists()) || !newData.exists() && root.child('pk').child($pin).child($uid).exists() && newData.parent().parent().parent().parent().child('ps').child($pin).child($uid).val() === root.child('pk').child($pin).child($uid).val() && root.child('ps').child($pin).child($uid).val() !== root.child('pk').child($pin).child($uid).val())",
            ".validate": "newData.hasChildren(['n'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "i": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "a": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "$o": {
              ".validate": false
            }
          }
        },
        "ans": {
          ".write": "$pin.matches(/^[0-9]{6}$/) && !newData.exists() && root.child('hostkeys').child($pin).exists() && newData.parent().parent().parent().child('hs').child($pin).val() === root.child('hostkeys').child($pin).val() && root.child('hs').child($pin).val() !== root.child('hostkeys').child($pin).val()",
          "$k": {
            "$uid": {
              ".write": "$pin.matches(/^[0-9]{6}$/) && !data.exists() && newData.exists() && root.child('pk').child($pin).child($uid).exists() && newData.parent().parent().parent().parent().parent().child('ps').child($pin).child($uid).val() === root.child('pk').child($pin).child($uid).val() && root.child('ps').child($pin).child($uid).val() !== root.child('pk').child($pin).child($uid).val() && root.child('live').child($pin).child('players').child($uid).exists() && root.child('live').child($pin).child('cur').child('open').val() == true && (root.child('live').child($pin).child('cur').child('k').val()+'') == $k && now <= root.child('live').child($pin).child('cur').child('t0').val() + root.child('live').child($pin).child('cur').child('dur').val()*1000 + 3000",
              ".validate": "newData.hasChildren(['c','t'])",
              "c": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "t": {
                ".validate": "newData.val() == now"
              },
              "$o": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
