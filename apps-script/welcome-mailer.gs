gia,'Times New Roman',serif;font-size:18px;font-weight:bold;text-decoration:none;letter-spacing:1px;\">Open Heavenly Visions<\/a>\n    <div style=\"margin-top:14px;font-size:13px;color:#8f8da3;line-height:1.6;\">Tip: add the app to your home screen<br>so it opens like any other app.<\/div>\n  <\/td><\/tr>\n\n  <tr><td align=\"center\" style=\"padding:26px 28px 30px;font-size:12px;line-height:1.7;color:#8f8da3;border-top:1px solid #2c3657;\">\n    Glory be to God forever. Amen. &#10013;&#65039;<br>\n    Questions? Just reply to this email and we will help.<br>\n    You received this because {{by}} gave you access on Heavenly Visions.<br>\n    <a href=\"https://www.youtube.com/@Heavenly-Visions1\" style=\"color:#e3b45c;text-decoration:none;\">Watch us on YouTube<\/a>\n  <\/td><\/tr>\n\n<\/table>\n<\/td><\/tr>\n<\/table>\n<\/body>\n<\/html>\n"};
var ROLES = ['student', 'servant', 'coordinator', 'priest', 'master'];

function out(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}

function esc(t) {
  return String(t || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}


function toHex(bytes) {
  return bytes.map(function (b) { return ('0' + ((b + 256) % 256).toString(16)).slice(-2); }).join('');
}

/* "Your access is ready" email. The data comes signed by the games backend, so nobody else can make this mailer send it. */
function sendGranted(m) {
  if (MAIL_SECRET === 'CHANGE_ME' || !m || !GRANTED[m.role]) return out({ ok: false, error: 'auth' });
  var to = String(m.to || '').trim().toLowerCase();
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(to) || to.length > 80) return out({ ok: false, error: 'email' });
  var sig = toHex(Utilities.computeHmacSha256Signature([to, m.first, m.role, m.grade, m.church, m.by, m.ts].join('|'), MAIL_SECRET));
  if (sig !== m.sig || Math.abs(Date.now() - Number(m.ts)) > 2 * 3600 * 1000) return out({ ok: false, error: 'auth' });
  var cache = CacheService.getScriptCache();
  var key = 'gr_' + to + '_' + m.role + '_' + m.grade;
  if (cache.get(key)) return out({ ok: true, skipped: 'already sent' });
  var hour = Number(cache.get('hour') || 0), day = Number(cache.get('day') || 0);
  if (hour >= 40 || day >= 90) return out({ ok: false, error: 'busy' });
  var html = GRANTED[m.role]
    .replace(/\{\{name\}\}/g, esc(String(m.first || '').slice(0, 30)))
    .replace(/\{\{church\}\}/g, esc(String(m.church || '').slice(0, 60)))
    .replace(/\{\{grade\}\}/g, esc(String(m.grade || '').slice(0, 20)))
    .replace(/\{\{by\}\}/g, esc(String(m.by || 'Your church team').slice(0, 40)));
  MailApp.sendEmail({ to: to, subject: 'Your Heavenly Visions access is ready', htmlBody: html, name: 'Heavenly Visions', replyTo: REPLY_TO });
  cache.put(key, '1', 21600);
  cache.put('hour', String(hour + 1), 3600);
  cache.put('day', String(day + 1), 21600);
  return out({ ok: true });
}

function doGet() {
  return out({ ok: true, service: 'heavenly visions mailer' });
}

function doPost(e) {
  try {
    var b = JSON.parse(e.postData.contents);
    if (b.token !== TOKEN) return out({ ok: false, error: 'auth' });
    if (b.kind === 'granted') return sendGranted(b.mail);
    var to = String(b.to || '').trim().toLowerCase();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(to) || to.length > 80) return out({ ok: false, error: 'email' });
    var role = ROLES.indexOf(b.role) >= 0 ? b.role : 'student';
    var cache = CacheService.getScriptCache();
    if (cache.get('to_' + to)) return out({ ok: true, skipped: 'already sent' });
    var hour = Number(cache.get('hour') || 0);
    if (hour >= 40) return out({ ok: false, error: 'busy' });
    var day = Number(cache.get('day') || 0);
    if (day >= 90) return out({ ok: false, error: 'busy' });
    var html = TEMPLATES[role]
      .replace(/\{\{name\}\}/g, esc(String(b.first || '').slice(0, 30)))
      .replace(/\{\{church\}\}/g, esc(String(b.church || '').slice(0, 60)));
    MailApp.sendEmail({ to: to, subject: 'Welcome to Heavenly Visions', htmlBody: html, name: 'Heavenly Visions', replyTo: REPLY_TO });
    cache.put('to_' + to, '1', 21600);
    cache.put('hour', String(hour + 1), 3600);
    cache.put('day', String(day + 1), 21600);
    return out({ ok: true });
  } catch (err) {
    return out({ ok: false, error: 'fail' });
  }
}
